<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<NeutralLanguage>en</NeutralLanguage>
		<LangVersion>preview</LangVersion>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<IsPublishable>False</IsPublishable>
		<IsPackable>false</IsPackable>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<RootNamespace>ExcelPRIMEXlsb.Bench</RootNamespace>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningLevel>7</WarningLevel>
		<NoWarn>$(NoWarn);CS8600;CS8602;CS8604</NoWarn>

		<!-- .NET 8+ Performance Optimizations for Benchmarking -->
		<TieredCompilation>true</TieredCompilation>
		<TieredCompilationQuickJit>true</TieredCompilationQuickJit>
		<TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
		<TieredPGO>true</TieredPGO>
		<!-- NEW in .NET 9: Dynamic PGO gets better -->
		<TieredCompilationDynamicPgo>true</TieredCompilationDynamicPgo>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Aspose.Cells" Version="26.10.0" />
		<PackageReference Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
		<PackageReference Include="ExcelDataReader" Version="4.0.0-beta1" />
		<PackageReference Include="Microsoft.VisualStudio.DiagnosticsHub.BenchmarkDotNetDiagnosers" Version="18.13.37903.2" />
		<PackageReference Include="Sylvan.Data.Excel" Version="0.5.8" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="System.Security.Cryptography.Xml" Version="10.0.13" />
		<PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="System.Security.Cryptography.Xml" Version="10.0.13" />
		<PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="System.Security.Cryptography.Xml" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\ExcelFAST\ExcelFAST.csproj" />
	  <ProjectReference Include="..\Excel_PRIME\Excel_PRIME.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Data\100mb.xlsx">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Data\Blank Data 1 Million Rows.xlsx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Data\sampledocs-50mb-xlsx-file-sst.xlsx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Data\sampledocs-50mb-xlsx-file.xlsx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Data\" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\Excel_PRIME.Bench\Data\100mb.xlsb" Link="Data\100mb.xlsb">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Include="..\Excel_PRIME.Bench\Data\Blank Data 1 Million Rows.xlsb" Link="Data\Blank Data 1 Million Rows.xlsb">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Include="..\Excel_PRIME.Bench\Data\sampledocs-50mb-xlsx-file-sst.xlsb" Link="Data\sampledocs-50mb-xlsx-file-sst.xlsb">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Include="..\Excel_PRIME.Bench\Data\sampledocs-50mb-xlsx-file.xlsb" Link="Data\sampledocs-50mb-xlsx-file.xlsb">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
