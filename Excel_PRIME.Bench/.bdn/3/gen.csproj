<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)b/</OutDir>
    <OutputPath>$(MSBuildThisFileDirectory)b/</OutputPath>
    <PublishDir>$(MSBuildThisFileDirectory)p/</PublishDir>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)o/</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);b/**;p/**;o/**;r/**</DefaultItemExcludes>
    <EnableDefaultItems>true</EnableDefaultItems>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyTitle>Excel_PRIME.Bench-net10.0-3</AssemblyTitle>
    <AssemblyName>Excel_PRIME.Bench-gen</AssemblyName>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>false</MSBuildTreatWarningsAsErrors>
    <!-- disabled due to https://github.com/dotnet/roslyn/issues/59421 -->
    <DebugSymbols>false</DebugSymbols>
    <RunAnalyzers>false</RunAnalyzers>
    <!-- fix for NETSDK1150: https://docs.microsoft.com/en-us/dotnet/core/compatibility/sdk/5.0/referencing-executable-generates-error -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <StartupObject>BenchmarkDotNet.Autogenerated.UniqueProgramName</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Z:\GitHub\Smurf-IV\Excel_PRIME\Excel_PRIME.Bench\Excel_PRIME.Bench.csproj" />
  </ItemGroup>
  <!-- Begin copied settings from benchmarks project -->
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <WarningLevel>7</WarningLevel>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8604</NoWarn>
  </PropertyGroup>
  <!-- End copied settings -->
  <!-- LangVersion comes after the copied settings so it overrides one copied from the benchmarks project -->
  <PropertyGroup>
    <LangVersion Condition="'$(LangVersion)' == '' Or ($([System.Char]::IsDigit('$(LangVersion)', 0)) And '$(LangVersion)' &lt; '9.0')">latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BenchmarkDotNetGatherReferences)' == 'true'">
    <SkipCompilerExecution>true</SkipCompilerExecution>
    <UseAppHost>false</UseAppHost>
    <SkipCopyBuildProduct>true</SkipCopyBuildProduct>
  </PropertyGroup>
  <Target Name="BdnWriteReferences" Condition="'$(BenchmarkDotNetGatherReferences)' == 'true'" AfterTargets="ResolveReferences">
    <WriteLinesToFile File="$(MSBuildThisFileDirectory)ref.txt" Lines="@(ReferencePath-&gt;'%(FullPath)|%(FrameworkReferenceName)|%(FrameworkFile)|%(ResolvedFrom)')" Overwrite="true" />
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)ref.props" Condition="'$(BenchmarkDotNetGatherReferences)' != 'true' And Exists('$(MSBuildThisFileDirectory)ref.props')" />
</Project>