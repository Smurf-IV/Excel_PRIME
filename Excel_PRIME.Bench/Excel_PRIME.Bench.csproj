<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0</TargetFrameworks>
		<NeutralLanguage>en</NeutralLanguage>
		<LangVersion>preview</LangVersion>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<IsPublishable>False</IsPublishable>
		<IsPackable>false</IsPackable>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<RootNamespace>ExcelPRIME.Bench</RootNamespace>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- .NET 8+ Performance Optimizations for Benchmarking -->
		<TieredCompilation>true</TieredCompilation>
		<TieredCompilationQuickJit>true</TieredCompilationQuickJit>
		<TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
		<PackageReference Include="FastExcel" Version="3.0.13" />
		<PackageReference Include="Microsoft.VisualStudio.DiagnosticsHub.BenchmarkDotNetDiagnosers" Version="18.7.37220.1" />
		<PackageReference Include="Sylvan.Data.Excel" Version="0.5.5" />
		<PackageReference Include="XlsxHelper" Version="2.1.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Excel_PRIME\Excel_PRIME.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Data\100mb.xlsx">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Data\Blank Data 1 Million Rows.xlsx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Data\sampledocs-50mb-xlsx-file-sst.xlsx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Data\sampledocs-50mb-xlsx-file.xlsx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
