<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<NeutralLanguage>en</NeutralLanguage>
		<LangVersion>preview</LangVersion>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<IsPublishable>False</IsPublishable>
		<IsPackable>false</IsPackable>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<RootNamespace>ExcelPRIME.Bench</RootNamespace>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningLevel>7</WarningLevel>
		<NoWarn>$(NoWarn);CS8600;CS8602;CS8604</NoWarn>

		<!-- .NET 8+ Performance Optimizations for Benchmarking -->
		<TieredCompilation>true</TieredCompilation>
		<TieredCompilationQuickJit>true</TieredCompilationQuickJit>
		<TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
		<TieredPGO>true</TieredPGO>
		<!-- NEW in .NET 9: Dynamic PGO gets better -->
		<TieredCompilationDynamicPgo>true</TieredCompilationDynamicPgo>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'" >
		<!-- Opt into .NET 11 Runtime Async (no EnablePreviewFeatures needed) -->
		<Features>$(Features);runtime-async=on</Features>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
		<PackageReference Include="FastExcel" Version="3.0.13" />
		<PackageReference Include="Microsoft.VisualStudio.DiagnosticsHub.BenchmarkDotNetDiagnosers" Version="18.13.37903.2" />
		<PackageReference Include="Sylvan.Data.Excel" Version="0.5.8" />
		<PackageReference Include="XlsxHelper" Version="2.1.0" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Condition="'$(TargetFramework)' == 'net8.0'" Include="System.Security.Cryptography.Xml" Version="10.0.13" />
		<PackageReference Condition="'$(TargetFramework)' == 'net9.0'" Include="System.Security.Cryptography.Xml" Version="10.0.13" />
		<PackageReference Condition="'$(TargetFramework)' == 'net10.0'" Include="System.Security.Cryptography.Xml" Version="11.0.0" />
		<PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="System.Security.Cryptography.Xml" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\ExcelFAST\ExcelFAST.csproj" />
	  <ProjectReference Include="..\Excel_PRIME\Excel_PRIME.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Data\100mb.xlsx">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Data\Blank Data 1 Million Rows.xlsx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Data\sampledocs-50mb-xlsx-file-sst.xlsx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Data\sampledocs-50mb-xlsx-file.xlsx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
