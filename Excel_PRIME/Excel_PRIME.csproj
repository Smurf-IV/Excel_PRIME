<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<NeutralLanguage>en</NeutralLanguage>
		<LangVersion>preview</LangVersion>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<IsPublishable>True</IsPublishable>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<RootNamespace>ExcelPRIME</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationIcon>../Excel.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="../Excel.ico" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
	</ItemGroup>

	<PropertyGroup>
		<Title>Excel_PRIME</Title>
		<PackageId>Excel-PRIME</PackageId>
		<RepositoryType>git</RepositoryType>
		<Copyright>© Smurf-IV</Copyright>
		<PackageProjectUrl>https://github.com/Smurf-IV/Excel_PRIME</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Smurf-IV/Excel_PRIME</RepositoryUrl>
		<PackageTags>csharp;xml;zip;excel;netcore;reader</PackageTags>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Description>E.xcel P.erformant R.eader via I.nterfaces for M.emory E.fficiency. Without using any external libraries. Optimised for Range extraction </Description>
		<Authors>Smurf-IV</Authors>
		<Deterministic>False</Deterministic>
		<VersionPrefix>0.$([System.DateTime]::UtcNow.ToString(yyMM)).$([System.DateTime]::UtcNow.DayOfYear)</VersionPrefix>
		<PackageReleaseNotes>../Release_Notes.md</PackageReleaseNotes>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageIcon>../Excel.png</PackageIcon>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PackageReadmeFile>../README.md</PackageReadmeFile>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0|AnyCPU'">
	  <IsTrimmable>True</IsTrimmable>
	  <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0|AnyCPU'">
	  <IsTrimmable>True</IsTrimmable>
	  <WarningLevel>8</WarningLevel>
	  <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0|AnyCPU'">
	  <IsTrimmable>True</IsTrimmable>
	  <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0|AnyCPU'">
	  <IsTrimmable>True</IsTrimmable>
	  <WarningLevel>8</WarningLevel>
	  <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../README.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<!--<Target Name="PrepareReleaseNotes" BeforeTargets="GenerateNuspec">
		<PropertyGroup>
			<PackageDescription>$([System.IO.File]::ReadAllText("../Release_Notes.md"))</PackageDescription>
		</PropertyGroup>
	</Target>-->
</Project>
