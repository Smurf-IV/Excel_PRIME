<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;</TargetFrameworks>
		<NeutralLanguage>en</NeutralLanguage>
		<LangVersion>preview</LangVersion>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<IsPublishable>False</IsPublishable>
		<IsPackable>false</IsPackable>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<RootNamespace>ExcelPRIMEXlsb.RangeBench</RootNamespace>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningLevel>7</WarningLevel>

		<!-- .NET 8+ Performance Optimizations for Benchmarking -->
		<TieredCompilation>true</TieredCompilation>
		<TieredCompilationQuickJit>true</TieredCompilationQuickJit>
		<TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Aspose.Cells" Version="26.4.0" />
		<PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="EPPlus-LGPL" Version="4.5.3.13" />
		<PackageReference Include="FreeSpire.XLS" Version="16.4.0" />
		<PackageReference Include="Microsoft.VisualStudio.DiagnosticsHub.BenchmarkDotNetDiagnosers" Version="18.7.37220.1" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.7" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Excel_PRIME.RangeBench\Excel_PRIME.RangeBench.csproj" />
	  <ProjectReference Include="..\Excel_PRIME\Excel_PRIME.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Data\100mb.xlsx">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Data\Blank Data 1 Million Rows.xlsx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Data\sampledocs-50mb-xlsx-file-sst.xlsx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Data\sampledocs-50mb-xlsx-file.xlsx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\Excel_PRIME.Bench\Data\100mb.xlsb" Link="Data\100mb.xlsb">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Include="..\Excel_PRIME.Bench\Data\Blank Data 1 Million Rows.xlsb" Link="Data\Blank Data 1 Million Rows.xlsb">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Include="..\Excel_PRIME.Tests\Data\pivot-tables.xlsb" Link="Data\pivot-tables.xlsb">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Data\" />
	</ItemGroup>

</Project>
