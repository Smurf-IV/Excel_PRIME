<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- Package Sources -->
	<packageSources>
		<!-- Official NuGet source -->
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
	</packageSources>
	<!-- Disabling source control integration for packages -->
	<config>
		<add key="repositoryPath" value="packages" />
		<add key="globalPackagesFolder" value=".nuget/packages" />
		<add key="disableSourceControlIntegration" value="true" />
	</config>
	<!-- Enabling package restore -->
	<packageRestore>
		<add key="enabled" value="true" />
		<add key="automatic" value="true" />
	</packageRestore>
	<!-- Trusted Signers (optional, for package signing) -->
	<trustedSigners>
		<author name="Microsoft">
			<certificate fingerprint="3F9001EA7B7E6C62DCEE4A3E87C3D1FF9F8E3F3A" hashAlgorithm="SHA256" />
		</author>
	</trustedSigners>
</configuration>