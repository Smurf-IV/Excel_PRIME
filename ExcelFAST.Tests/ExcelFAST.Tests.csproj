<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<NeutralLanguage>en</NeutralLanguage>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<IsTestProject>true</IsTestProject>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<RootNamespace>ExcelFAST.Tests</RootNamespace>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningLevel>7</WarningLevel>
		<NoWarn>$(NoWarn);CS8600;CS8602;CS8604</NoWarn>

		<!-- .NET 8+ Performance Optimizations -->
		<TieredCompilation>true</TieredCompilation>
		<TieredCompilationQuickJit>true</TieredCompilationQuickJit>
		<TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
		<TieredPGO>true</TieredPGO>
		<!-- NEW in .NET 9: Dynamic PGO gets better -->
		<TieredCompilationDynamicPgo>true</TieredCompilationDynamicPgo>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'" >
		<!-- Opt into .NET 11 Runtime Async (no EnablePreviewFeatures needed) -->
		<Features>$(Features);runtime-async=on</Features>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AwesomeAssertions" Version="9.6.0" />
		<PackageReference Include="AwesomeAssertions.Analyzers" Version="9.0.8">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector" Version="10.1.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageReference Include="NUnit" Version="5.0.0" />
		<PackageReference Include="NUnit.Analyzers" Version="4.15.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NUnit3TestAdapter" Version="6.3.1">
			<TreatAsUsed>true</TreatAsUsed>
		</PackageReference>
		<PackageReference Include="System.Linq.Async" Version="7.0.1" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\ExcelFAST\ExcelFAST.csproj" />
	  <ProjectReference Include="..\Excel_PRIME.Bench\Excel_PRIME.Bench.csproj" />
	  <ProjectReference Include="..\Excel_PRIMEXlsb.Bench\Excel_PRIMEXlsb.Bench.csproj" />
	  <ProjectReference Include="..\Excel_PRIMEXlsb.RangeBench\Excel_PRIMEXlsb.RangeBench.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Excel_PRIME.Tests\Data\**" Link="Data\%(RecursiveDir)%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
